{{!
    @template local_information_center/notification

    Search formular for users and category tags

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * firstpage
    * pages
    * lastpage

    Example context (json):
    {
      "firstpage": {
        "link": "...user_notification_dashboard.php?page=0"
      },
      "pages": [
        {
          "link": "...user_notification_dashboard.php?page=1",
          "num": 2,
          "active": false
        }
      ],
      "lastpage": {
        "link": "...user_notification_dashboard.php?page=30",
        "num": 31
      }
    }
}}

<!-- Pagination -->
<nav class="pagination pagination-centered justify-content-center">
    <ul class="pagination mt-1">
        {{#firstpage}}
            <li class="page-item">
                <a href="{{link}}" class="page-link">
                    <span aria-hidden="true">1</span>
                    <span class="sr-only">{{#str}} page, local_information_center {{/str}} 1</span>
                </a>
            </li>
            <li class="page-item disabled" data-page-number="1">
                <span class="page-link">…</span>
            </li>
        {{/firstpage}}

        {{#pages}}
            <li class="page-item {{#active}}active{{/active}}">
                <a href="{{link}}" class="page-link">
                    <span aria-hidden="true">{{num}}</span>
                    <span class="sr-only">{{#str}} page, local_information_center {{/str}} {{num}}</span>
                </a>
            </li>
        {{/pages}}

        {{#lastpage}}
            <li class="page-item disabled" data-page-number="1">
                <span class="page-link">…</span>
            </li>
            <li class="page-item">
                <a href="{{link}}" class="page-link">
                    <span aria-hidden="true">{{num}}</span>
                    <span class="sr-only">{{#str}} page, local_information_center {{/str}} {{num}}</span>
                </a>
            </li>
        {{/lastpage}}
    </ul>
</nav>