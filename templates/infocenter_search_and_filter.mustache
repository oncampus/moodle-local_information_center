{{!
    @template local_information_center/infocenter_search_and_filter

    Search formular for users and category tags

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * component -> Hidden notification component value (For further search requests)
    * category -> Hidden category value (For further search requests)
    * search -> Search value (For further search requests)
    * categories
        * link -> URL to access the filtered page
        * disabled -> Show button gray
        * name -> name of category tag

    Example context (json):
    {
      "component": "information_center",
      "category": 3,
      "search": "Sports",
      "categories": [
        {
          "link": "/local/information_center/pages/user_notification_dashboard.php?category=4",
          "disabled": true,
          "name": "Event"
        }
      ]
    }
}}

<div class="row g-3 mb-4">
    <form class="col-md-6">
        <div class="input-group">
            <input type="hidden" name="component" value="{{component}}">
            <input type="hidden" name="category" value="{{category}}">
            <input type="text" class="form-control" value="{{search}}" placeholder="Suchen" aria-label="Suchen"
                   name="query" data-region="input" autocomplete="off">
            <div class="input-group-append">
                <button type="submit" class="btn btn-primary search-icon">
                    <i class="icon fa fa-magnifying-glass fa-fw " aria-hidden="true"></i>
                    <span class="sr-only">{{#str}} search, local_information_center {{/str}}</span>
                </button>
            </div>
        </div>
    </form>
    <div class="col-md-6">
        <div class="d-flex flex-wrap">
            {{#categories}}
                <a href="{{link}}"
                   class="btn {{^disabled}}btn-primary{{/disabled}} {{#disabled}}btn-secondary{{/disabled}} mr-2 mb-2">{{name}}</a>
            {{/categories}}
        </div>
    </div>
</div>