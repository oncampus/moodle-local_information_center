{{!
    @template local_information_center/notification_filter_area

    Area for configuring filters for the message admin dashboard
    For example search for deleted notifications

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * filtersform -> html

    Example context (json):
    {
      "filtersform": "<Rendered moodle form>"
    }
}}

{{! Filters button }}
<button id="remote_notification_dropdown_btn" class="btn btn-outline-secondary ms-2" type="button"
        data-toggle="collapse" data-target="#remote_notification_dropdown" aria-expanded="false"
        title="{{#str}} filters, moodle {{/str}}">
    {{#pix}} i/filter, core {{/pix}}
    <span data-region="filter-button-label">
        {{#str}} filters, moodle {{/str}}
    </span>
</button>

{{! Filters content }}
<div id="remote_notification_dropdown" class="collapse" aria-labelledby="dropdownFiltersButton">
    <div id="filters" class="reportbuilder-filters-sidebar scroll-shadow" data-region="report-filters">
        <div class="px-3 pt-3">
            <div class="reportbuilder-filters-wrapper" data-region="filters-form">
                {{{filtersform}}}
            </div>
        </div>
    </div>
</div>

