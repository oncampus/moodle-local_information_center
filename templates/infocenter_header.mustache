{{!
    @template local_information_center/infocenter_header

    Header with title of the plugin and a link to the configurations

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * shortcuturl -> URL to the admin dashboard, if the user is a manager

    Example context (json):
    {
      "shortcuturl": "/local/information_center/pages/admin_notification_dashboard.php"
    }
}}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">{{#str}} overview:title, local_information_center {{/str}}</h4>
    {{#shortcuturl}}
        <a href="{{{shortcuturl}}}"
           data-bs-toggle="tooltip"
           data-bs-placement="top"
           title="{{#str}} overview:sendmessages, local_information_center {{/str}}">
            <i class="fa-solid fa-gear"></i>
        </a>
    {{/shortcuturl}}
</div>